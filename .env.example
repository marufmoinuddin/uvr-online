# UVR Local — optional overrides
#
# Docker Compose picks this file up automatically when it is named `.env`.
# Every value below has a working default, so this file is only needed to
# change something. Inference is standalone — there is no external
# MSST-WebUI checkout to point at.

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
# WebSocket URL for the live job feed, as seen BY THE BROWSER (the tab opens
# this socket itself, it does not go through the Next proxy).
# ⚠️ NEXT_PUBLIC_* values are inlined at BUILD time, so changing this needs a
# rebuild: `docker compose up -d --build web`.
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Server-side proxy target used by the Next route handlers under /api/*.
# Inside the compose network the worker is a separate container, so it must be
# addressed by service name — `localhost` there would mean the web container.
API_INTERNAL_URL=http://api:8000

# ⚠️ Do NOT set NEXT_PUBLIC_API_URL. Leaving it unset keeps the browser on
# same-origin /api/* requests, which are proxied by Next — and that proxy is
# where gzip compression + ETag revalidation live (see web/src/lib/http-json.ts).
# Pointing the browser straight at :8000 would bypass all of it.

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
# Compose sets these to the container paths below; run-local.sh exports its own
# equivalents based on the checkout layout.
OUTPUT_ROOT=/data/output
MODEL_CATALOG=/app/models.json
MODEL_STORE=/data/models
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128
NEXT_PUBLIC_WS_URL=ws://localhost:8000
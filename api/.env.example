# UVR Local API worker — environment
# Inference is standalone (audio-separator); no MSST-WebUI checkout needed.

# Where result stems are written
OUTPUT_ROOT=./output

# Where downloaded model weights are cached (mount this for persistence)
MODEL_STORE=./models

# Model catalog
MODEL_CATALOG=./models.json

# Which device separation runs on.
#   auto - CUDA when a usable GPU is present, otherwise CPU (default)
#   cuda - require CUDA; the worker refuses to start if there is none
#   cpu  - never touch the GPU
#
# "cuda" deliberately FAILS rather than falling back silently: a silent
# fallback turns "I asked for the GPU" into a CPU job that runs for an hour.
# The CPU image ships no CUDA runtime, so it sets this to "cpu" for you.
UVR_DEVICE=auto

# CPU-mode ceilings. A CPU run is orders of magnitude slower than a GPU run,
# so an unbounded job would hold the single-job queue for hours.
#   UVR_CPU_MAX_SECONDS - longest clip accepted in CPU mode (default 120)
#   UVR_CPU_MAX_BYTES   - largest upload accepted in CPU mode (default 64 MB)
#   UVR_CPU_JOB_TIMEOUT - wall-clock ceiling for one CPU job (default 1800s)
UVR_CPU_MAX_SECONDS=120
UVR_CPU_MAX_BYTES=67108864
UVR_CPU_JOB_TIMEOUT=1800

# How many threads CPU inference may use. Leave unset to use the machine's
# real limit (CPU affinity and any cgroup quota are both taken into account).
# Set it only if you know better than the container runtime does.
# UVR_CPU_THREADS=8

# CUDA memory tuning
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128
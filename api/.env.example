# UVR Local API worker — environment
# Inference is standalone (audio-separator); no MSST-WebUI checkout needed.

# Where result stems are written
OUTPUT_ROOT=./output

# Where downloaded model weights are cached (mount this for persistence)
MODEL_STORE=./models

# Model catalog
MODEL_CATALOG=./models.json

# CUDA memory tuning
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128
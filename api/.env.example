# UVR Local API worker — environment
# Path to the MSST-WebUI checkout (primary backend). Leave empty to use pymss.
MSST_ROOT=/home/maruf/git/MSST-WebUI

# Where result stems are written
OUTPUT_ROOT=./output

# Model catalog (seeded + merged with installed MSST models)
MODEL_CATALOG=./models.json

# CUDA memory tuning
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128
# UVR Local CPU worker
#
# The CPU counterpart of Dockerfile: same application, same API, same model
# catalogue — but no CUDA runtime and the CPU torch wheels. It is roughly a
# gigabyte smaller than the GPU image, which is the difference between
# "installs on a laptop" and "does not".
#
# The base is plain python:3.10-slim. The CUDA base image is ~2.5 GB on its
# own, all of it useless without a driver.
FROM python:3.10-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    UVR_DEVICE=cpu

# No CUDA libraries are installed, so the app is pinned to the CPU. "auto"
# would work too, but being explicit means a machine that later gains a GPU
# does not silently change how a pinned job behaves.

# ffmpeg decodes the uploaded audio; libsndfile is what soundfile links
# against. Neither is in the python image.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-cpu.txt .
RUN pip install --upgrade pip && pip install -r requirements-cpu.txt

# App code
COPY . .

ENV OUTPUT_ROOT=/data/output \
    MODEL_CATALOG=/app/models.json \
    MODEL_STORE=/data/models

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
